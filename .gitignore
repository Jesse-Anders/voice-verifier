# Audio / voice data — never commit
*.wav
*.m4a
*.caf
*.aac
*.flac
*.mp4
*.mov
# note: images/voice-verifier-brief-walkthrough.m4v (UI walkthrough, no voice data) is
# committed intentionally; .m4v is not matched by the rules above.

# Model weights / checkpoints — fetched or generated, never committed
*.pt
*.pth
*.ckpt
*.onnx
*.mlmodel
*.mlpackage
pretrained_models/

# Secrets / signing / environment
.env
.env.*
*.pem
*.p12
*.mobileprovision
*.cer
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Xcode / CocoaPods
build/
DerivedData/
*.xcuserstate
xcuserdata/
Pods/

# OS
.DS_Store
